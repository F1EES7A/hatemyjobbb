# แสดงหัวข้อหน้าเว็บแบบสวยงาม
st.markdown("<h1 class='main-title'>🎓 ครู AI ผู้ช่วยสืบค้นความรู้</h1>", unsafe_allow_html=True)
st.markdown("<p class='sub-title'>ปลอดภัย เข้าใจง่าย เหมาะสำหรับนักเรียนวัยเรียนทุกคนจ้า ✨</p>", unsafe_allow_html=True)

# แถบเมนูด้านซ้าย (Sidebar) สำหรับจัดการระบบ
st.sidebar.header("⚙️ ตั้งค่าระบบหลังบ้าน")
api_key = st.sidebar.text_input("กรุณาใส่ Google API Key ของคุณ:", type="password")

# เพิ่มปุ่มคำถามแนะนำ (Suggested Questions) เพื่อช่วยเด็กคิดไม่ออก
st.sidebar.markdown("---")
st.sidebar.markdown("💡 **หัวข้อน่าลองค้นหา:**")
suggested_topics = [
    "ทำไมท้องฟ้าถึงเป็นสีฟ้า?",
    "ต้นไม้ปรุงอาหารได้อย่างไร?",
    "ไดโนเสาร์สูญพันธุ์เพราะอะไร?",
    "ประวัติศาสตร์วันสุนทรภู่"
]
for topic in suggested_topics:
    if st.sidebar.button(topic):
        st.session_state.search_query = topic

# =================================================================
# 🧠 2. จัดการหลังบ้าน (BACKEND PROMPT & CONTROL)
# =================================================================

# กฎเหล็กควบคุมพฤติกรรม AI (System Instruction)
STUDENT_PROMPT = """
คุณคือ 'ครู AI ใจดี' ผู้เชี่ยวชาญด้านการสอนเด็กวัยเรียน (ประถม-มัธยม) 
คุณต้องตอบคำถามด้วยกฎเหล็กดังต่อไปนี้อย่างเคร่งครัด:
1. ภาษา: ใช้ภาษาไทยที่สุภาพ เป็นกันเอง มีหางเสียง (ครับ/ค่ะ/จ้า) เข้าใจง่ายมาก ไม่ใช้ศัพท์เทคนิคยากๆ หากเลี่ยงไม่ได้ให้วงเล็บอธิบายสั้นๆ
2. รูปแบบ: ห้ามเขียนยาวเป็นพารากราฟยัดเยียด ให้แบ่งเป็นข้อๆ (1, 2, 3) หรือใช้ Bullet points ชัดเจน
3. ความปลอดภัย: ห้ามตอบเรื่องความรุนแรง เรื่องเพศ สิ่งผิดกฎหมาย การกลั่นแกล้ง หรือเรื่องที่ไม่เหมาะสมกับเด็กเด็ดขาด หากเจอคำถามประเภทนี้ ให้ตอบปฏิเสธอย่างสุภาพและเปลี่ยนไปชวนคุยเรื่องที่เป็นประโยชน์แทน
4. ความถูกต้อง: ต้องอิงความจริงตามหลักวิชาการ ห้ามมโนหรือแต่งเรื่องโกหก
5. ส่วนเสริม: ในตอนท้ายของคำตอบ ต้องมีหัวข้อ "💡 เกร็ดความรู้น่าคิด" เสมอ เพื่อกระตุ้นให้เด็กอยากเรียนรู้ต่อ
"""

# เช็กกล่องข้อความ (ถ้าเด็กกดปุ่มแนะนำ ให้ดึงมาใส่ในกล่องค้นหา)
if "search_query" not in st.session_state:
    st.session_state.search_query = ""

user_query = st.text_input(
    "🔍 หนูอยากค้นคว้าเรื่องอะไรวันนี้ บอกครูได้เลยครับ/ค่ะ:", 
    value=st.session_state.search_query,
    placeholder="เช่น ทำไมฝนถึงตก?, สรุปเรื่องระบบสุริยะสั้นๆ"
)

# ระบบตรวจสอบการทำงานหลังบ้าน
if api_key:
    if user_query:
        with st.spinner("⏳ ครู AI กำลังเปิดห้องสมุดค้นข้อมูลให้แป๊บนึงน้า..."):
            try:
                # เชื่อมต่อกับ Google Cloud API
                client = genai.Client(api_key=api_key)
                
                # ส่งคำสั่งไปประมวลผลที่โมเดล Gemini 2.5 Flash
                response = client.models.generate_content(
                    model='gemini-2.5-flash',
                    contents=user_query,
                    config=types.GenerateContentConfig(
                        system_instruction=STUDENT_PROMPT,
                        temperature=0.3 # ตั้งค่าให้ตอบตรงความจริงสูง ไม่มโนฟุ้งซ่าน
                    )
                )
                
                # แสดงผลลัพธ์ในกล่องข้อความที่อ่านง่าย (Frontend Output)
                st.markdown("---")
                st.balloons() # แสดงเอฟเฟกต์ลูกโป่งเพิ่มความตื่นเต้นให้เด็กๆ
                st.markdown(f"### 📝 ผลการค้นคว้าเรื่อง: **{user_query}**")
                
                # ใส่กรอบสีฟ้าล้อมรอบคำตอบเพื่อความสวยงาม
                st.info(response.text)
                
            except Exception as e:
                # จัดการเมื่อระบบพัง (Error Handling หลังบ้าน) เพื่อไม่ให้หน้าเว็บค้าง
                st.error("😥 เกิดข้อผิดพลาดหลังบ้าน: กรุณาตรวจสอบว่า API Key ถูกต้อง หรือลองกดใหม่อีกครั้งนะครับ")
else:
    # เตือนให้ผู้ปกครองหรือครูใส่ Key ก่อน
    st.warning("⚠️ สำหรับผู้ปกครอง/คุณครู: กรุณาใส่ 'Google API Key' ที่แถบเมนูด้านซ้ายเพื่อเริ่มระบบให้น้องๆ นะครับ")

